{
  "name": "gamepilot",
  "version": "0.15.13",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "smoke:chat": "node scripts/chat-ui-smoke.mjs",
    "smoke:goals": "node scripts/agent/goal-ui-smoke.mjs",
    "smoke:dsh-live": "node scripts/agent/dsh-live-readonly.mjs",
    "setup:dsh": "node scripts/setup-dsh-runtime.mjs",
    "agent:incident": "node scripts/agent/incident.mjs",
    "agent:eval": "node scripts/agent/evaluate.mjs",
    "smoke:planner": "node scripts/agent/ui-smoke.mjs",
    "preview:planner": "npm run build && electron . --planner-preview",
    "agent:plan": "node scripts/agent/plan.mjs",
    "agent:tools": "node scripts/agent/run.mjs",
    "acceptance": "node scripts/acceptance/run.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "preview": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test -- --maxWorkers=4 && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "setup:electron": "install-electron",
    "format": "prettier --write apps packages games tests scripts *.json *.ts",
    "format:check": "prettier --check apps packages games tests scripts *.json *.ts",
    "setup:ocr": "node scripts/setup-ocr.mjs",
    "package:portable": "npm run setup:ocr && npm run verify && node scripts/package-portable.mjs",
    "release:prune": "node scripts/release/prune-releases.mjs",
    "setup:maacore": "node scripts/setup-maacore.mjs",
    "build:bridge": "node scripts/build-bridge.mjs"
  },
  "dependencies": {
    "@maaxyz/maa-node": "5.13.0",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "license": "AGPL-3.0-only"
}
