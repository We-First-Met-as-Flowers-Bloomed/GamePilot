  "resume-confirm": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sessionId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9_:.-]+$"
      },
      "reviewId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9_:.-]+$"
      },
      "revision": { "type": "integer", "minimum": 0 },
